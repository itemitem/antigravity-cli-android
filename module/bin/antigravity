#!/system/bin/sh
# Antigravity CLI (agy) launcher -- one entry point for every caller on the
# device: root shells, adb, and Termux (via the wrapper service.sh installs).
#
# The `agy` binary is a Go binary from Google, but it's cgo-enabled (linked
# against glibc for DNS/resolver + threading, not statically linked like a
# plain Go build). Bionic has no glibc dynamic linker, so it must run through
# a bundled one -- same idea as the claude-code module's musl loader.
#
# This module ships no /system overlay at all (see README "Cara kerja"), so
# both the pool and the loader always live at fixed, non-mounted paths --
# no "mounted vs. fallback" branching needed anymore.

MODDIR=/data/adb/modules/antigravity-cli
POOL=/data/adb/antigravity
LOADER="$MODDIR/loader"

# termux-exec exports LD_PRELOAD pointing at a bionic .so. Go binaries don't
# use it, but unset anyway to be safe.
unset LD_PRELOAD

# Go's x509 verifier looks for a CA bundle at FHS paths that don't exist on
# Android (no /etc/ssl/certs). Without SSL_CERT_FILE every HTTPS call --
# OAuth token exchange, token refresh, the Gemini API itself -- fails with
# "x509: certificate signed by unknown authority". Termux's ca-certificates
# package ships a good bundle; point at it unless the caller already set one.
if [ -z "$SSL_CERT_FILE" ]; then
    for c in "${PREFIX:+$PREFIX/etc/tls/cert.pem}" /data/data/com.termux/files/usr/etc/tls/cert.pem \
             /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt; do
        [ -n "$c" ] || continue
        if [ -r "$c" ]; then SSL_CERT_FILE="$c"; break; fi
    done
    [ -n "$SSL_CERT_FILE" ] && export SSL_CERT_FILE
fi

# Android has no /tmp. Point TMPDIR somewhere writable.
if [ -z "$TMPDIR" ] || ! mkdir -p "$TMPDIR" 2>/dev/null || [ ! -w "$TMPDIR" ]; then
    TMPDIR=""
    for c in "${PREFIX:+$PREFIX/tmp}" "${HOME:+$HOME/.cache/antigravity}" /data/local/tmp/antigravity; do
        [ -n "$c" ] || continue
        if mkdir -p "$c" 2>/dev/null && [ -w "$c" ]; then TMPDIR="$c"; break; fi
    done
fi
[ -n "$TMPDIR" ] && export TMPDIR

# HOME fallback: Android doesn't always set HOME for all callers.
# su commonly sets HOME=/, which "mkdir -p" trivially succeeds on
# (already exists) without being writable -- must check -w too.
if [ -z "$HOME" ] || ! mkdir -p "$HOME" 2>/dev/null || [ ! -w "$HOME" ]; then
    for h in /data/local/tmp /data/adb/antigravity/home; do
        if mkdir -p "$h" 2>/dev/null && [ -w "$h" ]; then HOME="$h"; break; fi
    done
    export HOME
fi

REAL="$POOL/agy"

if [ ! -e "$REAL" ]; then
    echo "antigravity: $REAL tidak ada." >&2
    echo "        Pasang CLI dengan: su -c antigravity-update" >&2
    exit 127
fi

if [ ! -e "$LOADER/ld-linux-aarch64.so.1" ]; then
    echo "antigravity: loader glibc tidak ditemukan di $LOADER" >&2
    echo "        Modul rusak atau belum terpasang -- flash ulang zip modul." >&2
    exit 127
fi

exec "$LOADER/ld-linux-aarch64.so.1" --library-path "$LOADER" "$REAL" "$@"
