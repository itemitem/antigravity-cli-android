id=antigravity-cli
name=Antigravity CLI
version=v1.2.1
versionCode=4
author=itemitem
description=Menjalankan Google Antigravity CLI (agy) di Android tanpa Termux. Binary Go arm64 (cgo/glibc) langsung dari Google, self-updating, loader glibc bundled. Tidak memasang apa pun ke /system (no magic-mount) -- aman dari bootloop mount planner device tertentu. Butuh arm64 + root.
updateJson=https://raw.githubusercontent.com/itemitem/antigravity-cli-android/main/update.json
